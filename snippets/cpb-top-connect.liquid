{{ 'dialog-polyfill.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dialog-polyfill.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'basic-modal.js' | asset_url }}" defer="defer"></script>

<div class="cpb-connect">
  <a href="/pages/cpb-connect" class="cpb-connect-button tw-no-underline">クレ・ド・ポー ボーテ ID連携</a>

  <div id="open-modal" class="cpb-connect-desc tw-cursor-pointer">
    クレ・ド・ポー ボーテ メンバーシッププログラム会員とのID連携について
  </div>

  <basic-modal id="basic-modal">
    <dialog class="tw-w-[600px] tw-max-w-[90%]">
      <div class="close-button tw-cursor-pointer tw-absolute tw-top-2 tw-right-2 tw-z-10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          class="tw-w-6 tw-h-6"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </div>

      <div class="cpb-connect-modal">
        <h4>
          クレ・ド・ポー ボーテ<br>
          メンバーシッププログラム会員との<br>
          連携について
        </h4>

        <p>
          Perfumerie Sukiya Online Store会員情報と<br>
          クレ・ド・ポー ボーテ メンバーシッププログラム<br>
          会員IDを連携いただくことで<br>
          パーソナルなブランド体験をお楽しみいただけます。
        </p>

        <p>
          クレ・ド・ポー ボーテの会員ポイントがPerfumerie Sukiya Online Storeでの<br>
          購入で付与されますので、ぜひご登録ください。
        </p>

        <a href="/pages/cpb-connect" class="cpb-connect-button">登録手続きへ進む</a>
        <p class="cpb-connect-small">
          ※ Perfumerie Sukiya Online Store会員登録およびクレ・ド・ポー ボーテ
          メンバーシッププログラムのどちらも会員登録が必要となります。
        </p>
        <p class="cpb-connect-small">
          ※ Perfumerie Sukiya Online Storeにログインが必要です。未ログインの場合には、ログイン後にクレ・ド・ポー ボーテ
          ブランドトップ（<a
            href="{{ routes.collections_url }}/cle-de-peau-beaute"
            >https://online.sukiya.biz/collections/cle-de-peau-beaute</a
          >）から「クレ・ド・ポー ボーテ 会員連携」ボタンをクリックしてください。
        </p>
        <p class="cpb-connect-small">※ 会員ポイント付与・ご購入履歴の反映には5日程度お時間を頂戴いたします。</p>
        <h4>会員連携登録の特典</h4>
        <ul class="cpb-connect-benefits">
          <li class="cpb-connect-benefit">
            <div class="cpb-connect-benefit-image">
              <img
                class="pc-only"
                src="{{ 'memberbenefits_beautykey_pc.jpg' | asset_url }}"
                alt="Beauty Keyポイントが貯まる"
                width="189"
                height="220"
              >
              <img
                class="sp-only"
                src="{{ 'memberbenefits_beautykey_sp.jpg' | asset_url }}"
                alt="Beauty Keyポイントが貯まる"
                width="305"
                height="172"
              >
            </div>
            <div class="cpb-connect-benefit-body">
              <h5>Beauty Keyポイントが貯まる</h5>
              <p>
                資生堂の1ポイント1円として使えるBeauty Keyのポイントが同時に貯まるようになります。
              </p>
            </div>
          </li>

          <li class="cpb-connect-benefit">
            <div class="cpb-connect-benefit-image">
              <img
                class="pc-only"
                src="{{ 'IDlinkage_banner_pc.jpg' | asset_url }}"
                alt="ラディアンスギフト"
                width="324"
                height="263"
              >
              <img
                class="sp-only"
                src="{{ 'IDlinkage_banner_sp.jpg' | asset_url }}"
                alt="ラディアンスギフト"
                width="324"
                height="214"
              >
            </div>
            <div class="cpb-connect-benefit-body">
              <h5>ラディアンスギフト</h5>
              <p>
                大切なお客さまに、贅沢な時間を楽しんでいただくための特別なアイテムをご用意しております。貯めていただいたラディアンスポイントに応じて、感謝の気持ちを込めた記念品をお贈りします。
              </p>
            </div>
          </li>

          <li class="cpb-connect-benefit">
            <div class="cpb-connect-benefit-image">
              <img
                class="pc-only"
                src="{{ 'memberbenefits_experience_pc.jpg' | asset_url }}"
                alt="特別な体験"
                width="189"
                height="220"
              >
              <img
                class="sp-only"
                src="{{ 'memberbenefits_experience_sp.jpg' | asset_url }}"
                alt="特別な体験"
                width="305"
                height="172"
              >
            </div>
            <div class="cpb-connect-benefit-body">
              <h5>特別な体験</h5>
              <p>
                クレ・ド・ポー ボーテのメンバー限定イベントへのご招待、新商品のご案内、最新情報の優先通知や特別なキャンペーンをご体験いただけるようになります。
              </p>
            </div>
          </li>

          <li class="cpb-connect-benefit">
            <div class="cpb-connect-benefit-image">
              <img
                class="pc-only"
                src="{{ 'memberbenefits_counseling_pc.jpg' | asset_url }}"
                alt="パーソナルなカウンセリング"
                width="189"
                height="220"
              >
              <img
                class="sp-only"
                src="{{ 'memberbenefits_counseling_sp.jpg' | asset_url }}"
                alt="パーソナルなカウンセリング"
                width="305"
                height="172"
              >
            </div>
            <div class="cpb-connect-benefit-body">
              <h5>パーソナルなカウンセリング</h5>
              <p>
                簡単な設問への回答とスマートフォンのカメラで撮影した肌測定で、あなたの肌を解き明かし、あなたにおすすめの商品をご紹介します。<br>
                ※肌測定はPCではご利用いただけません。
              </p>
            </div>
          </li>
        </ul>

        <p>
          その他にも特典を用意しておりますので、<br>
          ぜひ、会員連携に登録してください！
        </p>

        <a href="/pages/cpb-connect" class="cpb-connect-button">登録手続きへ進む</a>
        <p class="cpb-connect-small">
          ※ Perfumerie Sukiya Online Store会員登録およびクレ・ド・ポー ボーテ
          メンバーシッププログラムのどちらも会員登録が必要となります。
        </p>
        <p class="cpb-connect-small">
          ※ Perfumerie Sukiya Online Storeにログインが必要です。未ログインの場合には、ログイン後にクレ・ド・ポー ボーテ
          ブランドトップ（https://online.sukiya.biz/collections/cle-de-peau-beaute）から「クレ・ド・ポー ボーテ
          会員連携」ボタンをクリックしてください。
        </p>
        <p class="cpb-connect-small">※ 会員ポイント付与・ご購入履歴の反映には5日程度お時間を頂戴いたします。</p>
      </div>
    </dialog>
  </basic-modal>
</div>
