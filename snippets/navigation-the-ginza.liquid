{% doc %}
  Renders one-level category links for THE GINZA.

  @param {collection} brand_collection - Collection containing THE GINZA products.
  @param {page} [story_page] - Published story page, when available.
  @param {string} [active_category] - Selected category tag.
{% enddoc %}
{%- if brand_collection != blank -%}
  {%- assign category_keys = 'skincare,protection,body,fragrance,sets' | split: ',' -%}
  {%- assign category_tags = 'スキンケア,プロテクション,ボディ,フレグランス,セット・その他' | split: ',' -%}
  <ul class="the-ginza__navigation" role="list">
    {%- for category_key in category_keys -%}
      {%- assign category_tag = category_tags[forloop.index0] -%}
      {%- assign category_translation = 'the_ginza.categories.' | append: category_key -%}
      {%- assign category_label = category_translation | t -%}
      <li>
        <a
          href="{{ brand_collection.url }}/{{ category_tag | handleize }}?view=the-ginza-products"
          {% if active_category == category_tag %}
            aria-current="page"
          {% endif %}
        >
          {{- category_label -}}
        </a>
      </li>
    {%- endfor -%}
    {%- if story_page != blank -%}
      <li>
        <a href="{{ story_page.url }}">{{ 'the_ginza.labels.story' | t }}</a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
