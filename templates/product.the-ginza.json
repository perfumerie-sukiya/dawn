{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase",
            "is_vendor": true
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle",
            "is_vendor": false
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "a2fac057-a160-42d6-afbe-9d2ec38856bb": {
          "type": "additional_info",
          "settings": {}
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "全成分",
            "icon": "clipboard",
            "content": "<p>{{ product.metafields.my_fields.ingredient | metafield_tag }}</p>",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "使用方法",
            "icon": "lipstick",
            "content": "<p>{{ product.metafields.my_fields.howtouse | metafield_tag }}</p>",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "注意事項",
            "icon": "check_mark",
            "content": "<p>{{ product.metafields.my_fields.caution | metafield_tag }}</p>",
            "page": ""
          }
        },
        "7bb31b76-c2dc-46fb-b8ac-af4d30d1221c": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "配送・手数料について",
            "icon": "truck",
            "content": "<h5><strong>【配送料について】 </strong><br/>・配送料は3,300円(税込)以上のお買い上げで全国一律無料<br/>・3,300円未満のお客様は全国一律500円です。<br/>・海外への配送は承っておりません。<br/><br/><strong>【発送について】<br/></strong>・最短でご注文の翌営業日に発送いたします。<br/>・土日祝日の発送は行っておりません。翌営業日の発送となります。<br/>・予約商品の発売日が土日祝日の場合も、翌営業日の発送となります。<br/>・ご注文商品がすべて揃い次第の発送となります。<br/>・予約商品と通常商品を同時にご注文いただいた場合は、予約商品の発売日以降にまとめて発送いたします。<br/><br/><strong>【在庫・お取り寄せについて】<br/></strong>・在庫状況により発送が遅れる場合がございます。<br/>・お取り寄せが必要な商品は、最大で5営業日以内に発送いたします。<br/>・メーカー欠品や国内欠品等により、メーカーからの納品に時間がかかる場合がございます。その際は別途ご連絡いたします。<br/><strong><br/>【ご注文が集中した場合】<br/></strong>・ご注文が集中した場合は、順次発送となる場合がございます。あらかじめご了承くださいますようお願いいたします。<br/><br/><strong>【配送業者に関して】</strong><br/>ヤマト運輸にてお送りいたします。</h5>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "a2fac057-a160-42d6-afbe-9d2ec38856bb",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-2",
        "collapsible-row-3",
        "7bb31b76-c2dc-46fb-b8ac-af4d30d1221c",
        "share"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "",
        "media_size": "small",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 0,
        "padding_bottom": 12
      }
    },
    "the_ginza_related": {
      "type": "related-products-the-ginza",
      "settings": {}
    }
  },
  "order": [
    "main",
    "the_ginza_related"
  ]
}
